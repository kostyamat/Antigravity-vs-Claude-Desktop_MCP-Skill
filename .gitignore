# ─── Board runtime data: never commit ──────────────────────────────
agent_bridge.db
agent_bridge.db-wal
agent_bridge.db-shm
agent_bridge.db.*
agent_bridge.json
agent_bridge_cursors.json
bridge_config.json
P0_PENDING.txt
*.log

# ─── Runtime directories ───────────────────────────────────────────
docs/
agent_bridge_bodies/
agent_bridge_archive/
agent_bridge_backups/
snapshot-*/
antigravity_relay/
# Created by the installer beside the bridge when no other place is configured:
# the agents' work and the user's agreements, not the bridge's source.
contracts/
sandbox/

# ─── Private: window and session identifiers ───────────────────────
gemini_convs.json
antigravity_sessions.json
current_antigravity_conv.txt

# ─── Python bytecode: carries the absolute path it was compiled from ───
__pycache__/
*.pyc

# ─── Backups and build artifacts ───────────────────────────────────
*.bak
*.bak*
*.backup.*
*.before-*
sharing/
*.zip

# ─── Working notes and handover: this machine's state, never published ───
# Working notes for this machine. The contents are excluded rather than the
# directory itself: git cannot re-include a file whose parent directory is
# excluded, and the rules below have to stay tracked. Without them a clone has
# no project instructions and the import in CLAUDE.md dangles. Everything else
# here holds real paths and session identifiers and stays out.
.agents/*
!.agents/AGENTS.md

# ─── Per-machine client settings ───────────────────────────────────
.claude/settings.local.json
